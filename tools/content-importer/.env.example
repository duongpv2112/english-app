# Copy to .env (same folder). These keys stay on your machine: never commit them and
# never add them to the production server.

# Database to fill. Local dev database, or the Neon connection string for production.
DATABASE_URL=postgres://english:english@localhost:5432/english_app

# enrich — https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5.
# ANTHROPIC_MODEL=

# tts — Azure portal → Speech resource → Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# tts — Cloudflare dashboard → R2 → Manage API tokens (Object Read & Write on the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=english-app-audio
