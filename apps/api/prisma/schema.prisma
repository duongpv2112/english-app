generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  newPerDay    Int      @default(20)
  timezone     String   @default("Asia/Ho_Chi_Minh")
  playbackRate Float    @default(1.0)
  startedAt    DateTime @default(now())
  cards        Card[]
}

model Word {
  id        String    @id @default(cuid())
  lemma     String    @unique
  // pos, ipa and meaningVi stay null until the content importer's `enrich` step fills them.
  pos       String?
  ipa       String?
  meaningVi String?
  tslRank   Int       @unique
  audioKey  String?
  examples  Example[]
  cards     Card[]
}

model Example {
  id       String  @id @default(cuid())
  wordId   String
  word     Word    @relation(fields: [wordId], references: [id])
  textEn   String
  textVi   String
  audioKey String?
  voice    String?

  @@index([wordId])
}

enum CardMode {
  RECOGNIZE
  LISTEN_TYPE
}

model Card {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  wordId        String
  word          Word        @relation(fields: [wordId], references: [id])
  mode          CardMode
  // FSRS state, as produced by ts-fsrs (see packages/shared/src/srs.ts).
  due           DateTime
  stability     Float
  difficulty    Float
  scheduledDays Int
  learningSteps Int         @default(0)
  reps          Int
  lapses        Int
  state         Int // 0 New, 1 Learning, 2 Review, 3 Relearning
  lastReview    DateTime?
  // Starting point when the state has to be rebuilt from the review logs.
  createdAt     DateTime    @default(now())
  logs          ReviewLog[]

  @@unique([userId, wordId, mode])
  @@index([userId, due])
}

model ReviewLog {
  id         String   @id // UUID made by the client, so a retried request is not stored twice
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id])
  rating     Int // 1 Again, 2 Hard, 3 Good, 4 Easy
  reviewedAt DateTime // when the user rated the card, on the client's clock
  receivedAt DateTime @default(now())

  @@index([cardId, reviewedAt])
}
