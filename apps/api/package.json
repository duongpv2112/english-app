{
  "name": "@english-app/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env src/seed-cli.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@english-app/shared": "workspace:*",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/secure-session": "^8.4.2",
    "@fastify/static": "^10.1.10",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "17.9.0-beta.17",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "vitest": "5.1.0"
  }
}
